{
  "manifest_version": 3,
  "name": "飞书文档转换器",
  "version": "2.13",
  "description": "飞书文档转Markdown — v2.13 batch8: pollConversion not_found处理(P0)+sharedPath跨块隔离(P0)+exportDocx命名修正(P1)+嵌套表格文本降级(P1)+navigateToUrl URL校验(P1)+工具函数同步(P2) | 历史: v2.9-v2.12 累计66+修复",
  "permissions": ["activeTab", "storage", "downloads", "alarms"],
  "host_permissions": ["https://*.feishu.cn/*", "https://*.larksuite.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.feishu.cn/*", "https://*.larksuite.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "飞书文档转换器"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
