{
  "manifest_version": 3,
  "name": "飞书文档转换器",
  "version": "2.9",
  "description": "飞书文档转Markdown — v2.9 P0鲁棒性修复(消息超时/block上限/空数据检测/占位冲突)+P1错误恢复(存储降级/下载反馈)",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://*.feishu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.feishu.cn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
