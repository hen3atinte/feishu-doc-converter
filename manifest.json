{
  "manifest_version": 3,
  "name": "飞书文档转换器",
  "version": "2.12",
  "description": "飞书文档转Markdown — v2.12 batch7: injectUI body空值保护(P0)+markdown空值检查(P1)+taskId缺失保护(P1)+withLock锁恢复(P2)+空markdown下载保护(P2) | 历史: v2.9-v2.11 累计60+修复",
  "permissions": ["activeTab", "storage", "downloads", "alarms"],
  "host_permissions": ["https://*.feishu.cn/*", "https://*.larksuite.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.feishu.cn/*", "https://*.larksuite.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "飞书文档转换器"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
