{
  "manifest_version": 3,
  "name": "飞书文档转换器",
  "version": "2.10",
  "description": "飞书文档转Markdown — v2.10 batch5: getPlainText的iat数组验证(P0)+list_active_tasks处理器(P1)+download简化为直下(P1)+pollingActive早期抛异常(P1)+clearInterval改clearTimeout(P2)",
  "permissions": ["activeTab", "storage", "downloads", "alarms"],
  "host_permissions": ["https://*.feishu.cn/*", "https://*.larksuite.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.feishu.cn/*", "https://*.larksuite.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "飞书文档转换器"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
